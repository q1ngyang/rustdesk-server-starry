{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starry.example/contracts/relay-telemetry/v1/telemetry.schema.json",
  "title": "Starry HBBR authenticated relay telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "telemetry_schema",
    "process_instance_id",
    "sequence",
    "observed_at_unix_ms",
    "uptime_seconds",
    "version",
    "relay_probe_protocol",
    "relay_load_protocol",
    "load_basis_points",
    "active_sessions",
    "pending_pairs",
    "capacity_sessions",
    "bandwidth_bps",
    "bandwidth_ema_alpha_basis_points",
    "capacity_bandwidth_bps",
    "draining",
    "admission_open",
    "admission_rejections",
    "probe_malformed",
    "probe_unsupported",
    "probe_rate_limited",
    "probe_successful",
    "telemetry_auth_failures"
  ],
  "properties": {
    "telemetry_schema": {"const": 1},
    "process_instance_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9-]+$"},
    "sequence": {"type": "integer", "minimum": 1},
    "observed_at_unix_ms": {"type": "integer", "minimum": 0},
    "uptime_seconds": {"type": "integer", "minimum": 0},
    "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+-]+$"},
    "relay_probe_protocol": {"type": "integer", "minimum": 1},
    "relay_load_protocol": {"type": "integer", "minimum": 1},
    "load_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "active_sessions": {"type": "integer", "minimum": 0},
    "pending_pairs": {"type": "integer", "minimum": 0},
    "capacity_sessions": {"type": "integer", "minimum": 1},
    "bandwidth_bps": {"type": "integer", "minimum": 0},
    "bandwidth_ema_alpha_basis_points": {"type": "integer", "minimum": 1, "maximum": 10000},
    "capacity_bandwidth_bps": {"type": "integer", "minimum": 1},
    "draining": {"type": "boolean"},
    "admission_open": {"type": "boolean"},
    "admission_rejections": {"type": "integer", "minimum": 0},
    "probe_malformed": {"type": "integer", "minimum": 0},
    "probe_unsupported": {"type": "integer", "minimum": 0},
    "probe_rate_limited": {"type": "integer", "minimum": 0},
    "probe_successful": {"type": "integer", "minimum": 0},
    "telemetry_auth_failures": {"type": "integer", "minimum": 0}
  }
}
