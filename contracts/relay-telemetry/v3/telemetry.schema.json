{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starry.example/contracts/relay-telemetry/v3/telemetry.schema.json",
  "title": "Starry HBBR authenticated relay telemetry v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "telemetry_schema",
    "process_instance_id",
    "sequence",
    "observed_at_unix_ms",
    "uptime_seconds",
    "version",
    "relay_probe_protocol",
    "relay_load_protocol",
    "fast_media",
    "load_basis_points",
    "active_sessions",
    "pending_pairs",
    "capacity_sessions",
    "bandwidth_bps",
    "bandwidth_ema_alpha_basis_points",
    "capacity_bandwidth_bps",
    "draining",
    "admission_open",
    "admission_rejections",
    "probe_malformed",
    "probe_unsupported",
    "probe_rate_limited",
    "probe_successful",
    "telemetry_auth_failures"
  ],
  "properties": {
    "telemetry_schema": {"const": 3},
    "process_instance_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9-]+$"},
    "sequence": {"type": "integer", "minimum": 1},
    "observed_at_unix_ms": {"type": "integer", "minimum": 0},
    "uptime_seconds": {"type": "integer", "minimum": 0},
    "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._+-]+$"},
    "relay_probe_protocol": {"type": "integer", "minimum": 1},
    "relay_load_protocol": {"type": "integer", "minimum": 1},
    "fast_media": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "renewal_protocol",
        "enabled",
        "healthy",
        "udp_port",
        "active_allocations",
        "active_streams",
        "hello_accepted",
        "cookie_rejected",
        "bind_succeeded",
        "bind_rejected",
        "grant_rejected",
        "role_mismatch",
        "session_mismatch",
        "allocation_mismatch",
        "rebinds",
        "forwarded_packets",
        "forwarded_bytes",
        "dropped_packets",
        "rate_limited",
        "replay_rejected",
        "expired_allocations",
        "listener_failures",
        "replay_window_packets",
        "maximum_forward_sequence_jump",
        "max_session_seconds",
        "transition_seconds",
        "post_expiry_recovery_seconds",
        "per_ip_bytes_per_second",
        "global_bytes_per_second",
        "reserved_bytes_per_second",
        "peak_per_ip_reserved_bytes_per_second",
        "active_role_reservations",
        "renewal_grants_accepted",
        "renewal_grants_replayed",
        "renewal_rejected_invalid",
        "renewal_rejected_binding",
        "renewal_rejected_sequence",
        "renewal_rejected_expired",
        "post_expiry_rebinds",
        "replay_rejected_duplicate",
        "replay_rejected_too_old",
        "replay_rejected_jump",
        "admission_accepted",
        "admission_rejected_allocation",
        "admission_rejected_per_ip",
        "admission_rejected_global",
        "minimum_remaining_ttl_seconds",
        "expiring_within_30_seconds"
      ],
      "properties": {
        "protocol": {"const": 1},
        "renewal_protocol": {"const": 1},
        "enabled": {"type": "boolean"},
        "healthy": {"type": "boolean"},
        "udp_port": {"type": "integer", "minimum": 0, "maximum": 65535},
        "active_allocations": {"type": "integer", "minimum": 0},
        "active_streams": {"type": "integer", "minimum": 0},
        "hello_accepted": {"type": "integer", "minimum": 0},
        "cookie_rejected": {"type": "integer", "minimum": 0},
        "bind_succeeded": {"type": "integer", "minimum": 0},
        "bind_rejected": {"type": "integer", "minimum": 0},
        "grant_rejected": {"type": "integer", "minimum": 0},
        "role_mismatch": {"type": "integer", "minimum": 0},
        "session_mismatch": {"type": "integer", "minimum": 0},
        "allocation_mismatch": {"type": "integer", "minimum": 0},
        "rebinds": {"type": "integer", "minimum": 0},
        "forwarded_packets": {"type": "integer", "minimum": 0},
        "forwarded_bytes": {"type": "integer", "minimum": 0},
        "dropped_packets": {"type": "integer", "minimum": 0},
        "rate_limited": {"type": "integer", "minimum": 0},
        "replay_rejected": {"type": "integer", "minimum": 0},
        "expired_allocations": {"type": "integer", "minimum": 0},
        "listener_failures": {"type": "integer", "minimum": 0},
        "replay_window_packets": {"const": 2048},
        "maximum_forward_sequence_jump": {"const": 1048576},
        "max_session_seconds": {"type": "integer", "minimum": 600, "maximum": 86400},
        "transition_seconds": {"type": "integer", "minimum": 5, "maximum": 60},
        "post_expiry_recovery_seconds": {"type": "integer", "minimum": 10, "maximum": 120},
        "per_ip_bytes_per_second": {"type": "integer", "minimum": 65536},
        "global_bytes_per_second": {"type": "integer", "minimum": 1048576},
        "reserved_bytes_per_second": {"type": "integer", "minimum": 0},
        "peak_per_ip_reserved_bytes_per_second": {"type": "integer", "minimum": 0},
        "active_role_reservations": {"type": "integer", "minimum": 0},
        "renewal_grants_accepted": {"type": "integer", "minimum": 0},
        "renewal_grants_replayed": {"type": "integer", "minimum": 0},
        "renewal_rejected_invalid": {"type": "integer", "minimum": 0},
        "renewal_rejected_binding": {"type": "integer", "minimum": 0},
        "renewal_rejected_sequence": {"type": "integer", "minimum": 0},
        "renewal_rejected_expired": {"type": "integer", "minimum": 0},
        "post_expiry_rebinds": {"type": "integer", "minimum": 0},
        "replay_rejected_duplicate": {"type": "integer", "minimum": 0},
        "replay_rejected_too_old": {"type": "integer", "minimum": 0},
        "replay_rejected_jump": {"type": "integer", "minimum": 0},
        "admission_accepted": {"type": "integer", "minimum": 0},
        "admission_rejected_allocation": {"type": "integer", "minimum": 0},
        "admission_rejected_per_ip": {"type": "integer", "minimum": 0},
        "admission_rejected_global": {"type": "integer", "minimum": 0},
        "minimum_remaining_ttl_seconds": {"type": ["integer", "null"], "minimum": 0},
        "expiring_within_30_seconds": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"properties": {"udp_port": {"minimum": 1}}}
        },
        {
          "if": {"properties": {"healthy": {"const": true}}},
          "then": {"properties": {"enabled": {"const": true}, "udp_port": {"minimum": 1}}}
        },
        {
          "properties": {
            "reserved_bytes_per_second": {"maximum": 8589934592},
            "peak_per_ip_reserved_bytes_per_second": {"maximum": 1073741824}
          }
        }
      ]
    },
    "load_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
    "active_sessions": {"type": "integer", "minimum": 0},
    "pending_pairs": {"type": "integer", "minimum": 0},
    "capacity_sessions": {"type": "integer", "minimum": 1},
    "bandwidth_bps": {"type": "integer", "minimum": 0},
    "bandwidth_ema_alpha_basis_points": {"type": "integer", "minimum": 1, "maximum": 10000},
    "capacity_bandwidth_bps": {"type": "integer", "minimum": 1},
    "draining": {"type": "boolean"},
    "admission_open": {"type": "boolean"},
    "admission_rejections": {"type": "integer", "minimum": 0},
    "probe_malformed": {"type": "integer", "minimum": 0},
    "probe_unsupported": {"type": "integer", "minimum": 0},
    "probe_rate_limited": {"type": "integer", "minimum": 0},
    "probe_successful": {"type": "integer", "minimum": 0},
    "telemetry_auth_failures": {"type": "integer", "minimum": 0}
  }
}
