[Unit]
Description=RustDesk HBBR with Starry telemetry and optional FastMedia UDP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rustdesk-starry
Group=rustdesk-starry
WorkingDirectory=/var/lib/rustdesk-server-starry/relay
Environment=RELAY_DATA_DIR=/var/lib/rustdesk-server-starry/relay
Environment=STARRY_REQUIRE_PERSISTENT_STATE=1
EnvironmentFile=-/var/lib/rustdesk-server-starry/relay/starry/enrollment/relay-compat.env
ExecStart=/usr/bin/hbbr
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rustdesk-server-starry

[Install]
WantedBy=multi-user.target
