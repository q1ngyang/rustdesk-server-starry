[Unit]
Description=RustDesk Starry ID/Rendezvous Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rustdesk-starry
Group=rustdesk-starry
WorkingDirectory=/var/lib/rustdesk-server-starry
Environment=STARRY_LOCAL_CONTROL_TOKEN_FILE=/etc/rustdesk-server-starry/local-control.token
ExecStart=/usr/bin/hbbs --starry-config=/etc/rustdesk-server-starry/managed/config.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/rustdesk-server-starry

[Install]
WantedBy=multi-user.target
