# Copy to .env on each Relay-only node.
STARRY_IMAGE=ghcr.io/q1ngyang/rustdesk-server-starry
STARRY_VERSION=1.1.16-patch-v1.3.0
RUSTDESK_LOG_LEVEL=info
RELAY_COMPOSE_PROJECT_NAME=rustdesk-relay
RELAY_HBBR_CONTAINER_NAME=rustdesk-hbbr
RELAY_DATA_DIR=./data

# Paste the complete one-line content of the centre id_ed25519.pub file.
# This is a public key, not the private id_ed25519 file.
RUSTDESK_PUBLIC_KEY=PASTE_CENTRE_ID_ED25519_PUBLIC_KEY_HERE

# The bundled probe/load HBBR uses these units: bandwidth and speed values are Mb/s,
# DOWNGRADE_START_CHECK is seconds, and DOWNGRADE_THRESHOLD is a fraction.
RELAY_SINGLE_BANDWIDTH=128
RELAY_TOTAL_BANDWIDTH=1024
RELAY_MAX_SESSIONS=10000
RELAY_PROBE_PER_IP_PER_MINUTE=120
RELAY_PROBE_GLOBAL_PER_MINUTE=10000
# Optional until Relay Quality is enabled. This is a container path, not the secret value.
RELAY_TELEMETRY_SECRET_FILE=
RELAY_DRAINING_FILE=/root/starry/hbbr.draining
RELAY_LIMIT_SPEED=32
RELAY_DOWNGRADE_START_CHECK=1800
RELAY_DOWNGRADE_THRESHOLD=0.66
