# Docker Compose variable example for rustdesk-server-starry.
#
# Copy this file to `.env` next to compose.yaml before deployment:
#   cp examples/.env.example .env
#
# When downloaded from a GitHub Release, this file is named
# `compose.env.example`; rename it to `.env` before running Compose.
#
# These values are used only for Docker Compose interpolation. Compose does not
# inject this file into HBBS or HBBR. Keep GEO rules, MMDB download URLs, Secure
# TCP settings, and Relay priorities in data/starry/config.yaml.

# Container image repository without a tag or digest.
STARRY_IMAGE=ghcr.io/q1ngyang/rustdesk-server-starry

# Image tag. `latest` follows the newest Starry release. For production, pin an
# immutable version such as `1.1.16-patch-v1.0.0`, then upgrade deliberately.
STARRY_VERSION=latest

# Persistent host directory shared by HBBS and HBBR. A relative path is
# resolved from the directory containing compose.yaml. An absolute path is
# recommended when Compose is managed by systemd or another automation tool.
STARRY_DATA_DIR=./data

# Compose project and container names. Change all three when running more than
# one independent Starry stack on the same Docker host.
STARRY_COMPOSE_PROJECT_NAME=rustdesk-server-starry
STARRY_HBBS_CONTAINER_NAME=rustdesk-starry-hbbs
STARRY_HBBR_CONTAINER_NAME=rustdesk-starry-hbbr

# Docker restart policy. Common values: no, on-failure, always, unless-stopped.
STARRY_RESTART_POLICY=unless-stopped
