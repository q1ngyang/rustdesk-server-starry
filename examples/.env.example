# Docker Compose variables for the single-host example.
# Copy to `.env`; never commit the copied file or the `data` directory.

# One immutable Starry release image for HBBS and its compatible probe/load
# HBBR. Keeping both services on this tag prevents version drift.
STARRY_IMAGE=ghcr.io/q1ngyang/rustdesk-server-starry
STARRY_VERSION=1.1.16-patch-v1.3.1

# Shared persistent data. Use an absolute path under service managers.
STARRY_PERSIST_ROOT=./persist

STARRY_COMPOSE_PROJECT_NAME=rustdesk-server-starry
STARRY_HBBS_CONTAINER_NAME=rustdesk-starry-hbbs
STARRY_HBBR_CONTAINER_NAME=rustdesk-hbbr
STARRY_RESTART_POLICY=unless-stopped
RUSTDESK_LOG_LEVEL=info
RELAY_MAX_SESSIONS=10000
# Set to 1 after SP1 enrollment. An empty/wrong mount then fails before HBBR
# can silently start as a new manual Relay.
RELAY_REQUIRE_ENROLLMENT=0
RELAY_PROBE_PER_IP_PER_MINUTE=120
RELAY_PROBE_GLOBAL_PER_MINUTE=10000
# Optional until Relay Quality is enabled. This is a container path, not the secret value.
RELAY_TELEMETRY_SECRET_FILE=
RELAY_DRAINING_FILE=/var/lib/rustdesk-server-starry/relay/starry/hbbr.draining

# Starry feature configuration is not read from this ENV file. Edit
# persist/hbbs/starry/config.yaml after the first HBBS start.
