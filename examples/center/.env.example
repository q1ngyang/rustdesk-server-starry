# Copy to .env beside both centre Compose files.

STARRY_IMAGE=ghcr.io/q1ngyang/rustdesk-server-starry
STARRY_VERSION=1.1.16-patch-v1.1.0
RUSTDESK_SERVER_IMAGE=rustdesk/rustdesk-server
RUSTDESK_SERVER_VERSION=1.1.16

# This is an independent community API example, not a Starry dependency.
# Pin an immutable provider tag or digest after validating a release.
RUSTDESK_API_IMAGE=ghcr.io/liyan-lucky/rustdesk-api-server-pro
RUSTDESK_API_VERSION=latest

CENTER_COMPOSE_PROJECT_NAME=rustdesk-center
CENTER_HBBS_CONTAINER_NAME=rustdesk-starry-hbbs
CENTER_HBBR_CONTAINER_NAME=rustdesk-hbbr
CENTER_API_CONTAINER_NAME=rustdesk-api-server-pro
CENTER_SERVER_DATA_DIR=./data/server
CENTER_API_DATA_DIR=./data/api
CENTER_API_CONFIG_FILE=./server.yaml
RUSTDESK_LOG_LEVEL=info
TZ=Etc/UTC

# Host loopback port used by the API reverse proxy.
RUSTDESK_API_PORT=12345

# Replace both values before the first API start. The provider uses them only
# for initial account creation, but this reference keeps the protected values
# available on restart; follow the provider's current rotation procedure.
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
